# 이 도구는 .env 파일을 읽지 않습니다. 아래 변수를 셸 환경변수로 설정하세요.
# (README "환경변수 설정" 참고. 실제 키를 파일에 적어 커밋하지 마세요.)

# 필수: API Key (Gemini 또는 Claude 키)
# AI_API_KEY=YOUR_KEY

# 선택: 제공자 지정 (gemini | claude). 생략하면 키 모양으로 자동 판별
# AI_PROVIDER=gemini

# AI_API_KEY 대신 제공자별 변수도 쓸 수 있습니다
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
