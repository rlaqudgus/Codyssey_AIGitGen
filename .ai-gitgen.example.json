{
  "language": "ko",
  "base_branch": "main",
  "convention": {
    "name": "my-team",
    "commit_format": "<type>(<scope>): <제목>",
    "commit_types": ["feat", "fix", "docs", "refactor", "test", "chore"],
    "commit_rules": [
      "scope는 변경된 최상위 폴더 이름을 쓴다.",
      "제목은 명사형으로 끝낸다 (예: ~ 추가, ~ 수정)."
    ],
    "commit_examples": [
      "feat(cli): safe-mode 옵션 추가",
      "fix(git): 이름이 바뀐 파일 경로 파싱 오류 수정"
    ],
    "pr_title_format": "<type>(<scope>): <제목>",
    "pr_rules": ["존댓말(~했습니다)로 쓴다."],
    "pr_checklist": ["테스트 통과 확인", "문서 갱신"]
  },
  "safe_mode": {
    "max_files": 10,
    "max_lines": 200,
    "mask_patterns": ["EMP-\\d{5}"],
    "exclude_files": ["*.sql", "fixtures/*"]
  }
}
